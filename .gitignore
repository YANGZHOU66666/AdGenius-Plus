# Secrets and local Python environment
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.DS_Store

# Curated data/ and formal results/ are shared; runtime files stay local.
/artifacts/
data/**/.pairwise_*.lock
data/**/.rubric_*.lock
results/**/.run.lock

# Share only final human labels; keep original labels and review history local.
/deprecated/artifacts/eval/gold_review/
/deprecated/**/pairwise_annotations_*.jsonl

# Bulky retired runtime outputs and unused raw downloads stay local.
deprecated/artifacts/eval/gold_generation/
deprecated/artifacts/eval/pairwise/
deprecated/data/raw/

# Local workbench locks for the November 24 comparison
/results/nov24/annotations/.rubric_*.lock
